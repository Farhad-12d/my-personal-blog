# Postgres connection string (Netlify DB gives you this as NETLIFY_DATABASE_URL —
# copy it into DATABASE_URL, or point DATABASE_URL directly at it in netlify.toml)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used once by `npm run seed` to create your admin account
ADMIN_NAME="Farhad"
ADMIN_EMAIL="faizalfarhad663@gmail.com"
ADMIN_PASSWORD="Farhad@2006"

# Random 32+ character string used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
